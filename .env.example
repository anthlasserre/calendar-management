DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar_management
TZ=Europe/Paris

# Auth.js : secret pour signer les JWT (générer avec `openssl rand -base64 32`).
AUTH_SECRET=replace-me-with-a-random-base64-string

# URL publique de l'application (utilisée par Auth.js pour construire les
# liens de connexion). En production, mettez l'URL HTTPS de votre déploiement.
AUTH_URL=http://localhost:3000

# Resend : indispensable en production pour envoyer les liens de connexion.
# Si AUTH_RESEND_KEY est absent, le lien magique est journalisé dans la
# console (pratique pour le développement local).
AUTH_RESEND_KEY=
EMAIL_FROM=onboarding@resend.dev
